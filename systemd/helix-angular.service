[Unit]
Description=Helix Seller Angular Dev Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/run/media/milosvasic/DATA4TB/Projects/helix_seller/web
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/milosvasic/.npm-global/bin
ExecStartPre=/bin/sh -c 'cd /run/media/milosvasic/DATA4TB/Projects/helix_seller/web && test -f package.json'
ExecStart=/bin/sh -c 'cd /run/media/milosvasic/DATA4TB/Projects/helix_seller/web && exec npx ng serve --host 0.0.0.0 --port 4200'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=helix.target
